/target
**/*.rs.bk
*.perf
perf.data*

# Byte-compiled Python from the analysis scripts.
__pycache__/
*.pyc

# Per-job build trees. A cluster job gets its own `target/` so an editing session
# on the submit host cannot relink the binary a running arm invokes; see
# scripts/rusty-phase4.sbatch.
/target-job-*

# BinaryBuilder dry-run output. `products/` is tarballs, `build/` is unpacked
# destdirs; both are regenerated by packaging/yggdrasil/build_tarballs.jl.
/packaging/yggdrasil/build/
/packaging/yggdrasil/products/

# Slurm job logs land in the repo root. Ignore them *there* only -- the leading
# slash matters: the sbatch scripts copy each log into its own run directory
# under bench-results/, where it is provenance and must be committed. An
# unanchored `slurm-*.out` excluded those copies too, which is how job 6753261's
# SIGILL transcript went missing from the commit that documented it.
/slurm-*.out
# Prebuilt measurement binaries. `**` and not `*`, because a run directory may
# be nested one deeper -- `bench-results/<host>/<run>/bin/` -- and the
# single-star form silently staged a 1 MB executable from `neon-ab/bin/`.
bench-results/**/bin/
