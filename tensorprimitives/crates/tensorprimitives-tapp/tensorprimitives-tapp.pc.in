prefix=@PREFIX@
exec_prefix=${prefix}
libdir=@LIBDIR@
includedir=@INCLUDEDIR@

Name: tensorprimitives-tapp
Description: TAPP (Tensor Algebra Processing Primitives) C ABI over the tensorprimitives engines
URL: https://github.com/lkdvos/tensorprimitives-rs
Version: @VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -ltensorprimitives_tapp
# Only the static archive needs these: it bundles the Rust standard library. The
# cdylib carries its own DT_NEEDED entries and a consumer needs none of this.
Libs.private: -lpthread -ldl -lm
